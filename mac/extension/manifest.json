{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.1",
  "description": "Pause and daily limits for YouTube Shorts and Facebook Reels; blocks adult sites.",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "management",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "incognito": "spanning",
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "timer.js"
      ],
      "run_at": "document_idle"
    }
  ]
}